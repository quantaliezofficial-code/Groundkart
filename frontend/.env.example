# Copy to .env for local dev. Vite only exposes vars prefixed VITE_ to
# client-side code (anything else stays server-side-only, which doesn't
# apply here since this is a pure SPA — there is no server-side .env
# secret in this app).
VITE_API_URL=http://localhost:8000
VITE_SITE_URL=https://groundkart.com
