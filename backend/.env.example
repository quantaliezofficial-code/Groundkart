# ==============================================================================
# GroundKart Backend Environment Configuration
# Copy this file to .env and customize values for your deployment.
# Never commit the real .env file or production credentials to version control.
# ==============================================================================

# Environment mode: "dev" or "production"
# In production, strict security validations are enforced on startup:
# - JWT_SECRET_KEY must be >= 32 characters and cannot use the dev default.
# - DATABASE_URL must be explicitly configured and cannot use dev default.
# - PUBLIC_APP_URL must use HTTPS and cannot point to localhost.
# - CORS_ALLOWED_ORIGINS must all use HTTPS and cannot contain localhost or 127.0.0.1.
# - Auth refresh cookies are flagged Secure=True.
ENVIRONMENT=dev

# Database connection URL (asyncpg format for PostgreSQL).
# Required in production.
# - Development:  postgresql+asyncpg://groundbooking:devpassword@localhost:5432/groundbooking
# - Production:   postgresql+asyncpg://dbuser:strongpassword@dbhost:5432/groundbooking
DATABASE_URL=postgresql+asyncpg://groundbooking:devpassword@localhost:5432/groundbooking

# Secret key used for signing JWT access tokens.
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production, this must be explicitly set and at least 32 characters long.
JWT_SECRET_KEY=dev-only-not-for-production-CHANGE-ME

# ------------------------------------------------------------------------------
# Storage Configuration
# ------------------------------------------------------------------------------
# Storage backend: "local" (for dev/test) or "s3" (for production S3 / Cloudflare R2).
STORAGE_BACKEND=local

# Local file storage directories (used when STORAGE_BACKEND=local)
UPLOADS_DIR=/tmp/groundkart-uploads
PRIVATE_UPLOADS_DIR=/tmp/groundkart-private-uploads

# S3 / Cloudflare R2 object storage settings (used when STORAGE_BACKEND=s3)
# Public bucket for public venue photos & media:
S3_BUCKET_NAME=groundkart-public-uploads

# Private bucket for confidential owner verification documents (public access blocked):
PRIVATE_S3_BUCKET_NAME=groundkart-private-documents

# S3 API endpoint URL (leave unset for AWS S3; specify for Cloudflare R2 or MinIO, e.g. https://<account_id>.r2.cloudflarestorage.com):
S3_ENDPOINT_URL=

# AWS / Cloudflare R2 API credentials:
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Public base URL for fetching public media files.
# When using Cloudflare R2 or a CDN (CloudFront), S3 API endpoint is private.
# Set this to your public bucket domain or CDN URL (e.g. https://media.your-domain.com):
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# URLs and Networking
# ------------------------------------------------------------------------------
# Backend API server URL: used by LocalFileStorage to build public image URLs in dev.
APP_BASE_URL=http://localhost:8000

# Canonical public URL of the frontend application.
# Used by password-reset emails and account notifications.
# - Development:  http://localhost:3000
# - Production:   https://your-frontend-domain.com (must use HTTPS, cannot be localhost)
PUBLIC_APP_URL=http://localhost:3000

# Allowed CORS origins for browser API requests (comma-separated list).
# In production, every origin must begin with https:// and cannot contain localhost or 127.0.0.1.
# - Development:  http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# - Production:   https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ------------------------------------------------------------------------------
# Business Rules & Background Tasks
# ------------------------------------------------------------------------------
# How long (in minutes) an unpaid booking hold remains reserved before auto-release:
BOOKING_HOLD_DURATION_MINUTES=1440

# How often (in minutes) the background task sweeps and releases expired holds:
HOLD_SWEEP_INTERVAL_MINUTES=5

# Cancellation refund tiers:
CANCELLATION_FULL_REFUND_HOURS=48
CANCELLATION_PARTIAL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_PERCENT=50

# Platform commission percentage deducted from payouts:
PLATFORM_COMMISSION_PERCENT=10

# ------------------------------------------------------------------------------
# Initial Administrator Setup (scripts/admin_setup.py)
# ------------------------------------------------------------------------------
# ADMIN_EMAIL=admin@your-domain.com
# ADMIN_PHONE=9876543210
# ADMIN_PASSWORD=optional-strong-password (if omitted, a secure 16-character token is generated)
