# Copy to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=postgresql+asyncpg://groundbooking:devpassword@localhost:5432/groundbooking

# Generate a real one — do not use this value anywhere past local dev:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-for-production-CHANGE-ME

ENVIRONMENT=dev

# Decision Point C-5 — placeholder pending real client sign-off. See
# app/config.py's comment on this field for why 10 minutes (the original
# spec, sized for gateway checkout) no longer fits an offline-confirmed
# payment process.
BOOKING_HOLD_DURATION_MINUTES=1440

# Decision Point C-7 — placeholder pending real client sign-off, same
# treatment as C-5 above. No doc specifies the actual distance-from-event
# refund tiers; see app/config.py's comment on these three fields (and the
# phase summary doc for this slice) for the full reasoning.
CANCELLATION_FULL_REFUND_HOURS=48
CANCELLATION_PARTIAL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_PERCENT=50

# Decision Point C-10 — placeholder pending real client sign-off, same
# treatment as above. No doc gives a commission percentage anywhere.
PLATFORM_COMMISSION_PERCENT=10

